# Central dashboard
POSTGRES_USER=nuclei
POSTGRES_PASSWORD=changeme
POSTGRES_DB=nuclei
SECRET_KEY=change-this-to-a-long-random-string
SCANNER_TOKEN=change-this-scanner-token

# First admin (created on empty database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
ADMIN_EMAIL=admin@localhost

# HTTPS on port 8118 (Caddy issues an internal certificate)
# Use your real hostname if agents reach this host by name:
# SITE_ADDRESS=https://dashboard.example.com:8118
# PUBLIC_URL=https://dashboard.example.com:8118
SITE_ADDRESS=https://10.150.10.155:8118
PUBLIC_URL=https://10.150.10.155:8118

# Set to 1 after you install a publicly trusted certificate
AGENT_TLS_VERIFY=0

# Optional: skip real naabu/httpx/nuclei and emit sample results
SCAN_DRY_RUN=0

AGENT_IMAGE=nuclei-dashboard-agent:latest
AGENT_GIT_CONTEXT=https://github.com/JustinTDCT/nuclei-dashboard.git#refs/heads/main:scan_runtime
