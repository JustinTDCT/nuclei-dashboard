# Central dashboard
POSTGRES_USER=nuclei
# Required. The API refuses to start if this is empty or a known placeholder.
POSTGRES_PASSWORD=
POSTGRES_DB=nuclei
# Required. Use a long random value (openssl rand -hex 32).
SECRET_KEY=
# Required. Distinct from SECRET_KEY. The public HTTPS listener does not expose
# /api/internal; the central scanner still uses this on the Docker network.
SCANNER_TOKEN=

# Required when an SMTP password is stored. Must be a generated Fernet key,
# distinct from SECRET_KEY / SCANNER_TOKEN / POSTGRES_PASSWORD.
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Arbitrary strings are rejected; do not use "password1".
SETTINGS_ENCRYPTION_KEY=

# First admin (created on empty database)
ADMIN_USERNAME=admin
# Required only for the first start on an empty user table. Distinct from
# SECRET_KEY / SCANNER_TOKEN / POSTGRES_PASSWORD. After the first admin exists
# this may be removed. Changing it later does not reset an existing admin.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@localhost

# HTTPS on port 8118. Caddy uses ./certs/cert.pem and ./certs/key.pem
# (see Caddyfile). Use a publicly trusted pair, or a pair from your internal CA.
# SITE_ADDRESS=https://dashboard.example.com:8118
# PUBLIC_URL=https://dashboard.example.com:8118
SITE_ADDRESS=https://10.150.10.155:8118
PUBLIC_URL=https://10.150.10.155:8118

# Production default: verify central-server TLS.
# Lab/dev opt-out only: AGENT_TLS_VERIFY=0
# Internal CA: keep verification ON. On the agent host copy the CA PEM to
# ./agent-certs/ca.pem and set TLS_CA_FILE=/certs/ca.pem (container path).
# Do not put the CA in ./certs — that directory holds Caddy's cert.pem/key.pem.
# See docs/DEVELOPMENT.md.
AGENT_TLS_VERIFY=1

# Optional: skip real naabu/httpx/nuclei and emit sample results
SCAN_DRY_RUN=0

AGENT_IMAGE=nuclei-dashboard-agent:latest
# Immutable scan_runtime pin: full 40-character commit SHA only.
# Tags and refs/heads/main are rejected. The API does not resolve tags.
# After merging Agent/runtime changes, bump this to that commit.
AGENT_GIT_CONTEXT=https://github.com/JustinTDCT/nuclei-dashboard.git#956d510385b26d9715daa43ea1e2d0d733e0a56b:scan_runtime

# Central raw scanner evidence. Bytes live on the API volume; PostgreSQL
# stores metadata only. Default retention is 365 days and is configured in
# Admin → Settings. Changing the setting applies to newly stored artifacts.
RAW_ARTIFACT_DIR=/var/lib/nuclei-dashboard/raw-artifacts
# Reject a single upload larger than this many bytes (default 256 MiB).
RAW_ARTIFACT_MAX_BYTES=268435456

# Optional NVD CVE API 2.0 key. Never commit a real key.
# Without a key, refresh uses the public rate limit (sleeps between batches).
# NVD_API_KEY=
